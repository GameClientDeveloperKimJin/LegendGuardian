  setName: Floor1QuizSet
  questions:
  - questionImage: {fileID: 0}
    questionText: "\uD50C\uB77C\uC2A4\uD2F1 \uC74C\uB8CC\uBCD1\uC744 \uBC84\uB9B4
      \uB54C \uAC00\uC7A5 \uC62C\uBC14\uB978 \uBC29\uBC95\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uB0B4\uC6A9\uBB3C\uC744 \uADF8\uB300\uB85C \uB454 \uCC44 \uBC84\uB9B0\uB2E4"
    - "\uB77C\uBCA8\uACFC \uB69C\uAED1\uC744 \uBD84\uB9AC\uD574 \uBC84\uB9B0\uB2E4"
    - "\uC77C\uBC18\uC4F0\uB808\uAE30\uB85C \uBC84\uB9B0\uB2E4"
    - "\uB2E4\uB978 \uD50C\uB77C\uC2A4\uD2F1\uACFC \uBB36\uC5B4\uC11C \uBC84\uB9B0\uB2E4"
    correctAnswerIndex: 1
    hintText: "\"\uBD84\uB9AC\"\uAC00 \uD575\uC2EC\uC774\uC5D0\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uC885\uC774\uCEF5\uC744 \uBD84\uB9AC\uC218\uAC70\uD558\uAE30
      \uC804\uC5D0 \uD574\uC57C \uD558\uB294 \uD589\uB3D9\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uBB3C\uB85C \uD5F9\uAD70\uB2E4"
    - "\uBC18\uC73C\uB85C \uCC22\uB294\uB2E4"
    - "\uC0C9\uCE60\uD55C\uB2E4"
    - "\uB0C9\uB3D9\uC2E4\uC5D0 \uB123\uB294\uB2E4"
    correctAnswerIndex: 0
    hintText: "\uB0B4\uC6A9\uBB3C\uC774 \uB0A8\uC544 \uC788\uC73C\uBA74 \uC7AC\uD65C\uC6A9\uC774
      \uC5B4\uB824\uC6CC\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uB2E4\uC74C \uC911 \uC77C\uBC18\uC4F0\uB808\uAE30\uB85C \uBC84\uB824\uC57C
      \uD558\uB294 \uAC83\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uAE68\uB057\uD55C \uC885\uC774\uBC15\uC2A4"
    - "\uD22C\uBA85 \uD398\uD2B8\uBCD1"
    - "\uC74C\uC2DD\uBB3C\uC774 \uBB3B\uC740 \uD734\uC9C0"
    - "\uCE94 \uC74C\uB8CC\uC218"
    correctAnswerIndex: 2
    hintText: "\uC624\uC5FC\uB41C \uD734\uC9C0\uB294 \uC7AC\uD65C\uC6A9\uC774 \uC5B4\uB824\uC6CC\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uBC30\uD130\uB9AC\uB97C \uBC84\uB9B4 \uB54C \uAC00\uC7A5 \uC801\uC808\uD55C
      \uBC29\uBC95\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uC885\uB7C9\uC81C \uBD09\uD22C\uC5D0 \uB123\uB294\uB2E4"
    - "\uD558\uC218\uAD6C\uC5D0 \uBC84\uB9B0\uB2E4"
    - "\uC804\uC6A9 \uC218\uAC70\uD568\uC5D0 \uBC30\uCD9C\uD55C\uB2E4"
    - "\uC885\uC774\uC640 \uD568\uAED8 \uBC84\uB9B0\uB2E4"
    correctAnswerIndex: 2
    hintText: "\uD3D0\uAC74\uC804\uC9C0\uB294 \uB530\uB85C \uBAA8\uC544\uC57C \uD574\uC694."
