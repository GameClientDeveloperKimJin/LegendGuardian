  m_Script: {fileID: 11500000, guid: 6755a0faacdc89147a1274af949c77b7, type: 3}
  m_Name: Floor2QuizSet
  m_EditorClassIdentifier: 
  setName: Floor2QuizSet
  questions:
  - questionImage: {fileID: 0}
    questionText: "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294 \uBC29\uC758 \uBD88\uC744
      \uACC4\uC18D \uCF1C\uB450\uBA74 \uC5B4\uB5A4 \uBB38\uC81C\uAC00 \uC0DD\uAE38\uAE4C\uC694?"
    options:
    - "\uC804\uAE30 \uC0AC\uC6A9\uB7C9\uC774 \uC99D\uAC00\uD55C\uB2E4"
    - "\uD734\uB300\uD3F0 \uC18D\uB3C4\uAC00 \uBE68\uB77C\uC9C4\uB2E4"
    - "\uACF5\uAE30\uAC00 \uB354 \uAE68\uB057\uD574\uC9C4\uB2E4"
    - "\uC778\uD130\uB137\uC774 \uBE68\uB77C\uC9C4\uB2E4"
    correctAnswerIndex: 0
    hintText: "\uBD88\uC744 \uCF1C\uB450\uBA74 \uC804\uAE30\uB97C \uACC4\uC18D \uC0AC\uC6A9\uD574\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uC5D0\uB108\uC9C0\uB97C \uC808\uC57D\uD558\uB294 \uC62C\uBC14\uB978
      \uD589\uB3D9\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uC5D0\uC5B4\uCEE8\uC744 \uCF20 \uCC44 \uCC3D\uBB38 \uC5F4\uAE30"
    - "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294 \uC804\uC790\uAE30\uAE30 \uD50C\uB7EC\uADF8
      \uBF51\uAE30"
    - "TV\uB97C \uD558\uB8E8 \uC885\uC77C \uCF1C\uB450\uAE30"
    - "\uCDA9\uC804\uAE30\uB97C \uACC4\uC18D \uAF42\uC544\uB450\uAE30"
    correctAnswerIndex: 1
    hintText: "\uB300\uAE30\uC804\uB825\uB3C4 \uC804\uAE30\uB97C \uC0AC\uC6A9\uD574\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uC5EC\uB984\uCCA0 \uB0C9\uBC29 \uC5D0\uB108\uC9C0\uB97C \uC544\uB07C\uB294
      \uBC29\uBC95\uC73C\uB85C \uAC00\uC7A5 \uC801\uC808\uD55C \uAC83\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uBB38\uC744 \uC5F4\uACE0 \uC5D0\uC5B4\uCEE8 \uC0AC\uC6A9\uD558\uAE30"
    - "\uC5D0\uC5B4\uCEE8 \uC628\uB3C4\uB97C \uB108\uBB34 \uB0AE\uAC8C \uC124\uC815\uD558\uAE30"
    - "\uC801\uC815 \uC628\uB3C4\uB85C \uC124\uC815\uD558\uACE0 \uC120\uD48D\uAE30\uB97C
      \uD568\uAED8 \uC0AC\uC6A9\uD558\uAE30"
    - "\uD558\uB8E8 \uC885\uC77C \uC5D0\uC5B4\uCEE8 \uCD5C\uB300 \uC138\uAE30\uB85C
      \uC0AC\uC6A9\uD558\uAE30"
    correctAnswerIndex: 2
    hintText: "\uD568\uAED8 \uC0AC\uC6A9\uD558\uBA74 \uB0C9\uBC29 \uD6A8\uC728\uC774
      \uC88B\uC544\uC838\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uD734\uB300\uD3F0 \uCDA9\uC804\uC774 \uB05D\uB09C \uB4A4 \uCDA9\uC804\uAE30\uB97C
      \uACC4\uC18D \uAF42\uC544\uB450\uBA74 \uC5B4\uB5A4 \uBB38\uC81C\uAC00 \uC0DD\uAE38
      \uC218 \uC788\uC744\uAE4C\uC694?"
    options:
    - "\uBC30\uD130\uB9AC\uAC00 \uBB34\uD55C \uCDA9\uC804\uB41C\uB2E4"
    - "\uC804\uAE30\uB97C \uCD94\uAC00\uB85C \uC0AC\uC6A9\uD558\uAC8C \uB41C\uB2E4"
    - "\uB300\uD3F0 \uC0C9\uC774 \uBC14\uB010\uB2E4"
    - "\uC640\uC774\uD30C\uC774\uAC00 \uBE68\uB77C\uC9C4\uB2E4"
    correctAnswerIndex: 1
    hintText: "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC57D\uAC04\uC758 \uC804\uB825\uC774
      \uC18C\uBAA8\uB3FC\uC694!"
