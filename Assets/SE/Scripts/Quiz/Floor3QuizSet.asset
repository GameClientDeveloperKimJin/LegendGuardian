  m_Script: {fileID: 11500000, guid: 6755a0faacdc89147a1274af949c77b7, type: 3}
  m_Name: Floor3QuizSet
  m_EditorClassIdentifier: 
  setName: Floor3QuizSet
  questions:
  - questionImage: {fileID: 0}
    questionText: "\uC0AC\uB78C\uC774 \uC9C1\uC811 \uD398\uB2EC\uC744 \uBC1F\uC544
      \uC804\uAE30\uB97C \uB9CC\uB4DC\uB294 \uBC29\uC2DD\uC758 \uAC00\uC7A5 \uD070
      \uD2B9\uC9D5\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uC5F0\uB8CC\uAC00 \uD544\uC694 \uC5C6\uB2E4"
    - "\uC778\uD130\uB137\uC774 \uBE68\uB77C\uC9C4\uB2E4"
    - "\uBB3C\uC744 \uB9CE\uC774 \uC0AC\uC6A9\uD55C\uB2E4"
    - "\uC804\uAE30\uB97C \uBC84\uB9B0\uB2E4"
    correctAnswerIndex: 0
    hintText: "\uC0AC\uB78C\uC758 \uD798\uC744 \uC5D0\uB108\uC9C0\uB85C \uC0AC\uC6A9\uD574\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uC790\uAC00 \uBC1C\uC804 \uCCB4\uD5D8\uC5D0\uC11C \uC0AC\uB78C\uC774
      \uD398\uB2EC\uC744 \uB354 \uBE60\uB974\uAC8C \uB3CC\uB9AC\uBA74 \uC5B4\uB5BB\uAC8C
      \uB420\uAE4C\uC694?"
    options:
    - "\uC804\uAE30 \uC0DD\uC0B0\uB7C9\uC774 \uC99D\uAC00\uD560 \uC218 \uC788\uB2E4"
    - "\uC804\uAE30\uAC00 \uBAA8\uB450 \uC0AC\uB77C\uC9C4\uB2E4"
    - "\uBC30\uD130\uB9AC\uAC00 \uC790\uB3D9 \uC0AD\uC81C\uB41C\uB2E4"
    - "\uC778\uD130\uB137 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC9C4\uB2E4"
    correctAnswerIndex: 0
    hintText: "\uC6C0\uC9C1\uC784\uC774 \uB9CE\uC744\uC218\uB85D \uB354 \uB9CE\uC740
      \uC5D0\uB108\uC9C0\uAC00 \uB9CC\uB4E4\uC5B4\uC838\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uB2E4\uC74C \uC911 \uCE5C\uD658\uACBD \uC5D0\uB108\uC9C0 \uC0DD\uC0B0
      \uBC29\uC2DD\uC5D0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uAC83\uC740 \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294 \uC804\uAE30 \uACC4\uC18D \uCF1C\uB450\uAE30"
    - "\uC0AC\uB78C\uC774 \uC9C1\uC811 \uBC1C\uC804\uAE30\uB97C \uB3CC\uB824 \uC804\uAE30
      \uB9CC\uB4E4\uAE30"
    - "\uC4F0\uB808\uAE30\uB97C \uAE38\uC5D0 \uBC84\uB9AC\uAE30"
    - "\uD558\uB8E8 \uC885\uC77C \uC870\uBA85 \uCF1C\uB450\uAE30"
    correctAnswerIndex: 1
    hintText: "\uC2A4\uC2A4\uB85C \uC5D0\uB108\uC9C0\uB97C \uB9CC\uB4E4\uC5B4 \uC0AC\uC6A9\uD558\uB294
      \uBC29\uC2DD\uC774\uC5D0\uC694!"
  - questionImage: {fileID: 0}
    questionText: "\uC0AC\uB78C\uC758 \uC6C0\uC9C1\uC784\uC73C\uB85C \uC804\uAE30\uB97C
      \uB9CC\uB4DC\uB294 \uD65C\uB3D9\uC774 \uC758\uBBF8 \uC788\uB294 \uC774\uC720\uB294
      \uBB34\uC5C7\uC77C\uAE4C\uC694?"
    options:
    - "\uC5D0\uB108\uC9C0\uC758 \uC18C\uC911\uD568\uC744 \uCCB4\uD5D8\uD560 \uC218
      \uC788\uB2E4"
    - "\uC804\uAE30\uB97C \uBB34\uD55C\uB300\uB85C \uB9CC\uB4E4 \uC218 \uC788\uB2E4"
    - "\uBC30\uD130\uB9AC\uAC00 \uD544\uC694 \uC5C6\uC5B4\uC9C4\uB2E4"
    - "\uC804\uAE30\uC694\uAE08\uC774 \uC644\uC804\uD788 \uC0AC\uB77C\uC9C4\uB2E4"
    correctAnswerIndex: 0
    hintText: "\uC9C1\uC811 \uBAB8\uC73C\uB85C \uC5D0\uB108\uC9C0 \uC0DD\uC0B0\uC744
      \uACBD\uD5D8\uD558\uB294 \uAC83\uC774 \uC911\uC694\uD574\uC694!"
